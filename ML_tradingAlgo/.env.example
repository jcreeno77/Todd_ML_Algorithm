BROKERAGE_ACCOUNT_ID=your_brokerage_account_id
TD_AMERITRADE_CLIENT_ID=your_td_ameritrade_client_id

# --- Alerting (Twilio removed; see docs/notifications.md) ---
# Unset -> alerts log only. Set to a Discord webhook URL to also POST alerts.
ALERT_WEBHOOK_URL=

# --- Schwab API ---
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=schwab_token.json

# --- S3 storage (TFT data pipeline) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=

# --- Fundamentals source ---
FUNDAMENTALS_PROVIDER=yahoo   # fmp | yahoo
FMP_API_KEY=

# --- Trading execution ---
# DANGER: TRADING_ENABLED=true places REAL-MONEY orders on Schwab (no paper API).
# Leave false to run the loop in dry-run (orders logged via notify, not sent).
TRADING_ENABLED=false
